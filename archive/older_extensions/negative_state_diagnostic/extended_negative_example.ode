# Extended model from Part 13 of the supplied Claude record.
# All initial values are positive. Wood x1 crosses zero near t=0.063358.
# Diagnostic example: the rebellion term violates nonnegative-state invariance.
par a=2,k=0.5,c=1,g=0.5,h=0.3
par gd=0.35,b=0.1,eps=0.5
x1'=a*x1-k*x1^2+c*x5/(1+x1)-gd*x2*x1/(1+x1)-g*x1/(1+x3)-h*x1*x4-b*x3/(1+eps*x1)
x2'=a*x2-k*x2^2+c*x1/(1+x2)-gd*x3*x2/(1+x2)-g*x2/(1+x4)-h*x2*x5-b*x4/(1+eps*x2)
x3'=a*x3-k*x3^2+c*x2/(1+x3)-gd*x4*x3/(1+x3)-g*x3/(1+x5)-h*x3*x1-b*x5/(1+eps*x3)
x4'=a*x4-k*x4^2+c*x3/(1+x4)-gd*x5*x4/(1+x4)-g*x4/(1+x1)-h*x4*x2-b*x1/(1+eps*x4)
x5'=a*x5-k*x5^2+c*x4/(1+x5)-gd*x1*x5/(1+x5)-g*x5/(1+x2)-h*x5*x3-b*x2/(1+eps*x5)
init x1=0.01,x2=1,x3=2,x4=1,x5=0.01
@ meth=rungekutta,dt=0.0001,total=0.3
@ xp=t,yp=x1,xlo=0,xhi=0.3,ylo=-0.015,yhi=0.015
@ maxstor=10000,bound=1000
done
